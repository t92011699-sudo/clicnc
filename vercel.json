{
  "version": 2,
  "builds": [
    {
      "src": "apis/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/departments",
      "dest": "/apis/departments.js"
    },
    {
      "src": "/api/departments/(.*)",
      "dest": "/apis/departments.js"
    },
    {
      "src": "/api/doctors",
      "dest": "/apis/doctors.js"
    },
    {
      "src": "/api/doctors/(.*)",
      "dest": "/apis/doctors.js"
    },
    {
      "src": "/api/timeslots",
      "dest": "/apis/timeslots.js"
    },
    {
      "src": "/api/timeslots/(.*)",
      "dest": "/apis/timeslots.js"
    },
    {
      "src": "/api/bookings",
      "dest": "/apis/bookings.js"
    },
    {
      "src": "/api/bookings/(.*)",
      "dest": "/apis/bookings.js"
    },
    {
      "src": "/api/admin",
      "dest": "/apis/admin.js"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/apis/admin.js"
    }
  ]
}
